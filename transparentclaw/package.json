    "ora": "^7.0.0",
    "chalk": "^5.3.0",
    "express": "^4.18.0",
    "axios": "^1.6.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/ssh2": "^1.11.0",
